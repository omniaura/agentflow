### Code Examples

<?examples.curl bool>
#### cURL
```bash
curl -X <!endpoint.method> \
  '<!api.base_url><!endpoint.path>' \
  -H 'Content-Type: application/json' \
<?endpoint.requires_auth bool>
  -H 'Authorization: Bearer YOUR_API_KEY' \
</endpoint.requires_auth>
<?endpoint.has_body bool>
  -d '<!endpoint.curl_body>'
</endpoint.has_body>
```
</examples.curl>

<?examples.javascript bool>
#### JavaScript (fetch)
```javascript
const response = await fetch('<!api.base_url><!endpoint.path>', {
  method: '<!endpoint.method>',
  headers: {
    'Content-Type': 'application/json',
<?endpoint.requires_auth bool>
    'Authorization': 'Bearer YOUR_API_KEY',
</endpoint.requires_auth>
  },
<?endpoint.has_body bool>
  body: JSON.stringify(<!endpoint.js_body>)
</endpoint.has_body>
});

const data = await response.json();
console.log(data);
```
</examples.javascript>

<?examples.python bool>
#### Python (requests)
```python
import requests

url = "<!api.base_url><!endpoint.path>"
<?endpoint.requires_auth bool>
headers = {
    "Content-Type": "application/json",
    "Authorization": "Bearer YOUR_API_KEY"
}
</endpoint.requires_auth>
<?endpoint.has_body bool>
data = <!endpoint.python_body>

response = requests.<!endpoint.method_lower>(url, headers=headers, json=data)
</endpoint.has_body>
<?endpoint.no_body bool>
response = requests.<!endpoint.method_lower>(url, headers=headers)
</endpoint.no_body>
print(response.json())
```
</examples.python>

<?examples.go bool>
#### Go
```go
package main

import (
    "bytes"
    "encoding/json"
    "fmt"
    "net/http"
)

func main() {
    url := "<!api.base_url><!endpoint.path>"
    
<?endpoint.has_body bool>
    data := <!endpoint.go_body>
    jsonData, _ := json.Marshal(data)
    
    req, _ := http.NewRequest("<!endpoint.method>", url, bytes.NewBuffer(jsonData))
</endpoint.has_body>
<?endpoint.no_body bool>
    req, _ := http.NewRequest("<!endpoint.method>", url, nil)
</endpoint.no_body>
    
    req.Header.Set("Content-Type", "application/json")
<?endpoint.requires_auth bool>
    req.Header.Set("Authorization", "Bearer YOUR_API_KEY")
</endpoint.requires_auth>
    
    client := &http.Client{}
    resp, _ := client.Do(req)
    defer resp.Body.Close()
    
    // Handle response...
}
```
</examples.go>
</endpoint.featured>

