.route POST /notes CreateNote
.auth owner_id
.status 201
.prepare tidyNote
Creates a note for the caller, its body trimmed.
.sql :one
INSERT INTO notes (owner_id, body) VALUES (@owner_id, @body) RETURNING *

.route GET /notes ListNotes
.auth owner_id
.wrap notes
Lists the caller's notes, pinned first, as {"notes": [...]}.
.sql :many
SELECT * FROM notes
WHERE owner_id = @owner_id
ORDER BY pinned DESC, id

.route PATCH /notes/{id} UpdateNote
.auth owner_id
Replaces a note's body. The server sets updated_at.
.sql :execrows
UPDATE notes SET body = @body, updated_at = now()
WHERE id = @id AND owner_id = @owner_id

.route PUT /notes/{id}/pin PinNote
.auth owner_id
.sql :execrows
UPDATE notes SET pinned = true WHERE id = @id AND owner_id = @owner_id

.route GET /notes/latest LatestNote
.auth owner_id
.wrap note
.empty 200 {"note": null}
The caller's newest note as {"note": {...}}, or {"note": null} when they
have none: no notes isn't an error.
.sql :one
SELECT * FROM notes
WHERE owner_id = @owner_id
ORDER BY id DESC
LIMIT 1

.route DELETE /notes/{id} DeleteNote
.auth owner_id
.empty 204
Deletes one of the caller's notes. One already gone is deleted too, so a
client can retry.
.sql :execrows
DELETE FROM notes WHERE id = @id AND owner_id = @owner_id
