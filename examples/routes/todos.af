.route POST /todos CreateTodo
.auth owner_id
.status 201
Creates a todo for the caller.

.route GET /todos/{id} GetTodo
.auth owner_id

.route GET /todos ListTodos
.auth owner_id
Lists the caller's todos. Filter with ?done=true or ?done=false.

.route PUT /todos/{id}/done SetTodoDone
.auth owner_id

.route DELETE /todos/{id} DeleteTodo
.auth owner_id

.route GET /stats/count CountTodos
.public

.route GET /todos/{id}/title GetTodoTitle
.public
